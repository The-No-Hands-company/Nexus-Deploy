# === Nexus Deploy Configuration ===

# Public URL of this instance (no trailing slash)
BASE_URL=https://deploy.yourdomain.com

# All deployed apps get: appname.BASE_DOMAIN
BASE_DOMAIN=deploy.yourdomain.com

# Let's Encrypt SSL email
ACME_EMAIL=you@youremail.com

# Data directory — mount a volume here for persistence
DATA_DIR=/workspace

# JWT signing secret — generate: openssl rand -hex 32
JWT_SECRET=change_me_32_chars_minimum

# Database encryption secret — generate: openssl rand -hex 32
APP_SECRET=change_me_32_chars_minimum

# Initial admin credentials (used only on first boot)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change_me_on_first_login

# Allow new user registration after admin account is created
ALLOW_REGISTRATION=false

# Port for the API server (Traefik handles external routing)
PORT=3000

# === Node-specific values (nothing in the code names a domain) ===

# Where the dashboard, the API and the short links (<CONTROL_HOST>/<app>) live
CONTROL_HOST=deploy.yourdomain.com

# Where one app is reachable. {slug} and {BASE_DOMAIN} are substituted.
APP_HOST_PATTERN={slug}.{BASE_DOMAIN}

# Loopback ports apps are published on (the ingress reaches an app only here)
APP_PORT_RANGE=20000-29999

# The rootless sandbox Docker daemon. REQUIRED: with this empty, builds and
# containers refuse to run rather than fall back to the host's Docker.
SANDBOX_DOCKER_HOST=unix:///run/user/1001/docker.sock

# Mount point of the sandbox's size-capped storage (builds pause when it fills)
SANDBOX_STORAGE_PATH=/var/lib/nexus-deploy-sandbox

# === Ingress (how live apps are announced) ===
# Nexus Cloud's internal address. Empty means this node has no ingress to tell.
# CLOUD_URL=http://127.0.0.1:8787
# Cloud's credential for member apps (NEXUS_CLOUD_USER_APPS_KEY on the Cloud side).
# This is NOT the node API key. Required when CLOUD_URL is set.
# CLOUD_USER_APPS_KEY=
# CLOUD_TIMEOUT_MS=5000
# How often live apps are re-announced (Cloud's heartbeat)
# CLOUD_HEARTBEAT_MS=30000
# Hosting's site-proxy, asked whether a name already belongs to a site.
# Empty means this node has no Hosting to ask.
# HOSTING_SITE_URL=http://127.0.0.1:8090

# === Safeguards (the same for everyone; all optional) ===
# CAP_MEMORY_MB=512
# CAP_CPUS=0.5
# CAP_PIDS=256
# CAP_MAX_PROJECTS=5
# CAP_MAX_CONCURRENT_BUILDS=1
# CAP_MAX_BUILDS_PER_HOUR=6
# CAP_BUILD_TIMEOUT_MS=600000
# CAP_PULL_TIMEOUT_MS=600000
# CAP_MIN_HOST_FREE_PERCENT=15
# CAP_MAX_SANDBOX_USED_PERCENT=85
